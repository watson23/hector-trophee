# ---------------------------------------------------------------------------
# Firebase web app config
# Firebase console → Project settings → Your apps → Web app → SDK setup and config.
# Locally: copy to .env.local and fill in.  On Vercel: add each as an Environment
# Variable (Production + Preview + Development).
#
# Without VITE_FIREBASE_PROJECT_ID the app runs in demo mode: scores stay on the
# device. On a deployed domain it shows a red "Not connected" banner.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Access codes — set both for any real deployment; ask the organiser for the values.
# They are gates, not secrets (both end up in the client bundle), but they are not
# written into this public repo. Changing them and redeploying updates an already-seeded
# event; players are simply asked for the new code.
# ---------------------------------------------------------------------------
VITE_EVENT_PIN=
VITE_ADMIN_PIN=

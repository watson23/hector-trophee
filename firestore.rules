rules_version = '2';

// Hector Trophée 2026.
//
// Twenty friends on a golf trip, so the model is deliberately simple: anyone signed in
// (anonymously, from the app) may read and write this one event. The event PIN and the
// admin PIN are UI gates, not enforced here — a player with devtools could get past them.
// What these rules do stop is the wider internet writing to the database.
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/HECTOR2026 {
      allow read: if request.auth != null;
      // The pin hashes are writable on purpose. They are gates, not secrets — the PINs
      // ship in the client bundle either way — and the app reconciles them against
      // VITE_EVENT_PIN / VITE_ADMIN_PIN on load, so that a changed PIN in Vercel actually
      // takes effect instead of silently doing nothing.
      allow write: if request.auth != null;

      match /rounds/{roundId} {
        allow read, write: if request.auth != null;
      }

      match /cards/{cardId} {
        allow read: if request.auth != null;
        // A card only ever holds 18 holes of small integers.
        allow write: if request.auth != null
                     && request.resource.data.holes.size() <= 18;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

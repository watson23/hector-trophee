rules_version = '2';

// Hector Trophée 2026.
//
// Twenty friends on a golf trip, so the model is deliberately simple: anyone signed in
// (anonymously, from the app) may read and write any event here — which now covers both
// the tournament (HECTOR2026) and its test sandbox (HECTOR2026-test). The event PIN and
// the admin PIN are UI gates, not enforced here — a player with devtools could get past
// them. What these rules do stop is the wider internet writing to the database.
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId} {
      allow read: if request.auth != null;
      // The pin hashes are writable on purpose. They are gates, not secrets — the PINs
      // ship in the client bundle either way — and the app reconciles them against
      // VITE_EVENT_PIN / VITE_ADMIN_PIN on load, so that a changed PIN in Vercel actually
      // takes effect instead of silently doing nothing.
      allow write: if request.auth != null;

      match /rounds/{roundId} {
        allow read, write: if request.auth != null;
      }

      match /cards/{cardId} {
        allow read: if request.auth != null;
        // A card only ever holds 18 holes. Note this has to be create/update rather than
        // a blanket write: on a delete `request.resource` is null, so the size() check
        // would throw and make cards undeletable — which then blocks resetting a round.
        allow create, update: if request.auth != null
                              && request.resource.data.holes.size() <= 18;
        allow delete: if request.auth != null;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
